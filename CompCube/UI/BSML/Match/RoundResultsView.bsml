<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
     xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>

    <vertical anchor-pos-y="50" pref-width="100" pref-height="12">
        <level-bar name="RoundResultsLevelBar"/>
    </vertical>
    
    <horizontal bg="title-gradient" background-color="~titleBgColor" horizontal-fit="PreferredSize" vertical-fit="PreferredSize" preferred-height="12" pref-width="100" anchor-pos-x="0" anchor-pos-y="14">
        <text text="~titleText" font-size="10" all-uppercase="true" align="Midline" italics="true"/>
    </horizontal>

    <horizontal anchor-pos-x="0" anchor-pos-y="0">
        <vertical spacing="1.5">
            <text text="~winnerScoreText" align="Midline" font-size="4.75" italics="true"/>
            <text text="~loserScoreText" align="Midline" font-size="4.75" italics="true"/>
        </vertical>
    </horizontal>

    <vertical anchor-pos-x="0" anchor-pos-y="-20" bg="round-rect-panel" pref-height="15" pref-width="45" horizontal-fit="PreferredSize" vertical-fit="PreferredSize" spacing="6" pad="5">
        <text italics="true" text="Damage" align="Midline" underlined="true"/>
        <text text="~damageText" align="Midline" font-size="8" italics="true"/> 
    </vertical>
    
    <vertical anchor-pos-y="-35">
        <button interactable="~replayButtonInteractable" active="~replayButtonActive" pref-height='10' pref-width="34" on-click="replayButtonOnClick" text="Replay"/>
    </vertical>
</bg>