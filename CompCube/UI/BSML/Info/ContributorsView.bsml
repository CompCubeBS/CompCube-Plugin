<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
    <horizontal pref-width="90" pref-height="8" anchor-pos-y="41.5" horizontal-fit="PreferredSize" background="title-gradient" bg-color="#444444">
        <text text="Contributors" font-size="6" italics="true" all-uppercase="true" align="Midline"/>
    </horizontal>
    
    <vertical pref-width="90" anchor-pos-y="30" pref-height="10" vertical-fit="PreferredSize">
        <tab-selector tab-tag="contributors-tab-selector-tag" select-cell="on-contributors-tab-selector-cell-selected" id="contributors-tab-selector"/>
    </vertical>
    
    <macro.for-each pass-back-tags="true" hosts="contributors-tab-items">
        <tab tab-name="~tab-name" tags="contributors-tab-selector-tag" id="tab-object"/>
    </macro.for-each>
    
    <vertical bg="round-rect-panel" pref-width="80" preferred-height="55" vertical-fit="PreferredSize" horizontal-fit="PreferredSize" anchor-pos-y="-5">
        <grid cell-size-x="20" cell-size-y="10">
            <macro.for-each hosts="contributor-profiles" pass-back-tags="true">
                <horizontal child-expand-width="false">
                    <clickable-image preserve-aspect="true" src="~avatar-source" pref-height="7.5" pref-width="7.5"/>
                    <text align="MidlineLeft" text="~contributor-text"/>
                </horizontal>
            </macro.for-each>
        </grid>
    </vertical>
</bg>