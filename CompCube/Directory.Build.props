<?xml version="1.0" encoding="utf-8"?>
<!-- This file contains project properties used by the build. -->
<Project>
  <!-- Manifest -->
  <PropertyGroup>
    <AssemblyName>CompCube</AssemblyName>
    <Authors>Bela</Authors>
    <Version>0.2.1</Version>
    <GameVersion Condition="'$(GameVersion)' == ''">1.40.8</GameVersion>
    <Description>$ModDesc$</Description>
    <ProjectHome></ProjectHome>
    <ProjectSource></ProjectSource>
    <Donate></Donate>
  </PropertyGroup>
  <ItemGroup>
    <Dependency Include="BSIPA" Version="^4.3.5" />
    <Dependency Include="BeatSaberMarkupLanguage" Version="*" />
    <Dependency Include="SiraUtil" Version="*" />
    <Dependency Include="SongCore" Version="*" />
    <Dependency Include="BeatSaverSharp" Version="*" />
    <Dependency Include="protobuf-net" Version="*" />
  </ItemGroup>
  <!-- End Manifest -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DisableCopyToPlugins>true</DisableCopyToPlugins>
    <DisableZipRelease>true</DisableZipRelease>
  </PropertyGroup>
  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <SourceRoot Include="$(MSBuildThisFileDirectory)/"/>
  </ItemGroup>
  <PropertyGroup Condition="'$(NCrunch)' == '1'">
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
    <DisableCopyToPlugins>true</DisableCopyToPlugins>
    <DisableZipRelease>true</DisableZipRelease>
  </PropertyGroup>
</Project>
